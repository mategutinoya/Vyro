# Copia este archivo como .env.local y rellena tus valores.
# --- Supabase (públicas: van al navegador; la seguridad la da RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# --- Claude (SECRETA: sólo en el servidor, nunca con el prefijo NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# --- Opcional (SECRETA, sólo servidor) ---
# Con la clave de servicio, las cuentas se crean ya confirmadas (sin correo de confirmación).
# La integración de Supabase en Vercel la añade sola. Nunca con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres para instalar las tablas al publicar (Vercel la añade sola).
POSTGRES_URL_NON_POOLING=
