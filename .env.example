# Copia este archivo como ".env" y rellena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys / Data API).
# Son claves PÚBLICAS: es normal que viajen dentro de la app. La seguridad la da RLS.
# NUNCA pongas aquí la "secret key" ni la "service_role key".
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
